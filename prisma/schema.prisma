generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  BROKER
  BUILDER
  SERVICE_PROVIDER
  ADMIN
  SUPER_ADMIN
}

enum PropertyIntent {
  BUY
  RENT
  LEASE
  INVEST
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
  INDUSTRIAL
  AGRICULTURAL
  HOSPITALITY
  LUXURY
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum PropertyVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  NEEDS_CHANGES
  EXPIRED
}

enum PropertyDocumentType {
  SALE_DEED
  ENCUMBRANCE_CERTIFICATE
  TAX_RECEIPT
  APPROVAL_DOCUMENT
  FLOOR_PLAN
  OWNERSHIP_PROOF
  OTHER
}

enum ProfileVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProduct {
  FEATURED_LISTING
  PREMIUM_LISTING
  BROKER_MONTHLY
  BROKER_YEARLY
  BROKER_ENTERPRISE
  BUILDER_MONTHLY
  BUILDER_YEARLY
  BUILDER_ENTERPRISE
  STUDIO_PHOTOGRAPHY
  STUDIO_VIDEOGRAPHY
  STUDIO_DRONE
  STUDIO_REELS
  STUDIO_BROCHURE
  STUDIO_DESIGN
  STUDIO_ADS
  STUDIO_VIRTUAL_STAGING
  STUDIO_VOICEOVER
  SERVICE_BOOKING_DEPOSIT
  SERVICE_FINAL_PAYMENT
}

enum StudioOrderStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  PAID
  ASSIGNED
  IN_PRODUCTION
  QUALITY_CHECK
  DELIVERED
  CUSTOMER_APPROVED
  COMPLETED
  CANCELLED
  REVISION_REQUESTED
}

enum PaymentProvider {
  RAZORPAY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
  NURTURE
}

enum LeadSource {
  PROPERTY
  REEL
  SEARCH
  DASHBOARD
}

enum ContactAction {
  CALL
  WHATSAPP
  INQUIRY
}

enum NotificationModule {
  PROPERTY
  LEAD
  STUDIO
  BROKER
  BUILDER
  SERVICE
  PAYMENT
  AI
  ADMIN
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReportEntityType {
  PROPERTY
  USER
  SERVICE_PROVIDER
  BUILDER
  BROKER
  STUDIO
  REVIEW
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum WebhookProvider {
  RAZORPAY
  WHATSAPP
  SYSTEM
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum ServiceRequestStatus {
  requested
  quoted
  accepted
  booked
  completed
  cancelled
}

enum ServiceQuoteStatus {
  sent
  accepted
  rejected
  revised
  expired
}

enum ServiceBookingStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  UNDER_REVIEW
  HIDDEN
  REMOVED
}

enum BuilderProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  COMPLETED
}

enum BuilderConstructionStatus {
  PLANNING
  FOUNDATION
  STRUCTURE
  FINISHING
  READY
  COMPLETED
}

enum BuilderTowerStatus {
  ACTIVE
  ARCHIVED
}

enum BuilderUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

enum BuilderBookingStatus {
  RESERVED
  CONFIRMED
  RELEASED
  SOLD
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignChannel {
  HOMEZONE
  META
  GOOGLE
  YOUTUBE
  WHATSAPP
  OFFLINE
}

enum CommissionStatus {
  PENDING
  PAID
  OUTSTANDING
}

enum AutomationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum AutomationTrigger {
  NEW_LEAD
  FOLLOW_UP_DUE
  VISIT_SCHEDULED
  DEAL_WON
}

enum AIProvider {
  OPENAI
  GEMINI
  ANTHROPIC
}

enum AIMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AIRequestStatus {
  SUCCESS
  FAILED
  BLOCKED
  FALLBACK
}

enum AIMemoryScope {
  SHORT_TERM
  CONVERSATION
  USER_PREFERENCE
  SESSION
  LONG_TERM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id               String             @id @default(cuid())
  userId           String             @unique
  fullName         String?
  phone            String?            @unique
  whatsappVerified Boolean            @default(false)
  verificationStatus ProfileVerificationStatus @default(PENDING)
  verifiedAt       DateTime?
  verifiedBy       String?
  verificationNotes String?
  role             UserRole           @default(USER)
  country          String             @default("India")
  city             String?
  avatarUrl        String?
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties       Property[]         @relation("PropertyOwner")
  assignedLeads    Lead[]             @relation("AssignedLeads")
  userLeads        Lead[]             @relation("UserLeads")
  authoredLeadNotes LeadNote[]
  leadNotifications LeadNotification[]
  notifications     Notification[]      @relation("NotificationRecipient")
  reports           Report[]            @relation("ReportReporter")
  savedProperties  SavedProperty[]
  propertyViews    PropertyView[]
  shortlists       PropertyShortlist[]
  propertyDocuments PropertyDocument[]
  reelLikes        ReelLike[]
  savedReels       SavedReel[]
  following        ProfileFollow[]    @relation("ProfileFollowing")
  followers        ProfileFollow[]    @relation("ProfileFollowers")
  studioRequests   StudioRequest[]
  studioAssignments StudioAssignment[]
  studioNotifications StudioNotification[]
  serviceRequests  ServiceRequest[]
  serviceProviders ServiceProvider[]
  serviceBookingsAsCustomer ServiceBooking[] @relation("ServiceBookingCustomer")
  serviceReviews   ServiceReview[]
  builderProjects  BuilderProject[]
  builderTeam      BuilderTeamMember[] @relation("BuilderTeamOwner")
  builderMemberships BuilderTeamMember[] @relation("BuilderTeamProfile")
  builderBookings  BuilderBooking[] @relation("BuilderBookingBuyer")
  builderActivity  BuilderActivityLog[]
  aiReports        AiReport[]
  aiConversations  AIConversation[]
  aiMessages       AIMessage[]
  aiUsageLogs      AIUsageLog[]
  aiMemories       AIMemory[]
  payments         Payment[]
  subscriptions    Subscription[]
  brokerTeam       BrokerTeamMember[] @relation("BrokerTeamOwner")
  brokerMemberships BrokerTeamMember[] @relation("BrokerTeamProfile")
  leadAssignmentsMade BrokerLeadAssignment[] @relation("LeadAssignmentActor")
  brokerCommissions BrokerCommission[] @relation("BrokerCommissionOwner")
  agentCommissions BrokerCommission[] @relation("BrokerCommissionAgent")
  automationRules  BrokerAutomationRule[]
  clientDocuments  BrokerClientDocument[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([role, verificationStatus])
  @@index([verificationStatus])
  @@index([verifiedBy])
}

model Property {
  id            String           @id @default(cuid())
  ownerId       String?
  owner         Profile?         @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  intent        PropertyIntent
  category      PropertyCategory @default(RESIDENTIAL)
  propertyType  String
  coverImageUrl String?
  country       String           @default("India")
  state         String?
  city          String
  locality      String?
  timezone      String?
  address       String?
  latitude      Decimal?
  longitude     Decimal?
  price         Decimal?
  currency      String           @default("INR")
  areaValue     Decimal?
  areaUnit      String           @default("sqft")
  bedrooms      Int?
  bathrooms     Int?
  amenities     String[]         @default([])
  mediaUrls     String[]         @default([])
  videoUrl      String?
  virtualTourUrl String?
  status        ListingStatus    @default(DRAFT)
  verified      Boolean          @default(false)
  featured      Boolean          @default(false)
  featuredUntil DateTime?
  premium       Boolean          @default(false)
  premiumUntil  DateTime?
  verificationStatus PropertyVerificationStatus @default(PENDING)
  verifiedAt    DateTime?
  verifiedBy    String?
  verificationNotes String?
  aiSummary     String?
  propertyScore Int?
  riskScore     Int?
  savedBy       SavedProperty[]
  viewedBy      PropertyView[]
  shortlistItems ShortlistProperty[]
  documents     PropertyDocument[]
  leads         Lead[]
  siteVisits    LeadSiteVisit[]
  reels         PropertyReel[]
  callClicks    Int              @default(0)
  whatsappClicks Int             @default(0)
  inquirySubmissions Int         @default(0)
  comparisonCount Int            @default(0)
  studioRequests StudioRequest[]
  aiReports     AiReport[]
  payments      Payment[]
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([city])
  @@index([country, city])
  @@index([country, state, city])
  @@index([intent])
  @@index([category])
  @@index([currency])
  @@index([price])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([verified])
  @@index([featured, featuredUntil])
  @@index([premium, premiumUntil])
  @@index([verificationStatus])
  @@index([verifiedBy])
  @@index([latitude, longitude])
  @@index([status])
  @@index([status, createdAt])
  @@index([ownerId])
}

model SavedProperty {
  userId     String
  propertyId String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model PropertyView {
  userId     String
  propertyId String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
  @@index([userId, viewedAt])
  @@index([propertyId])
}

model PropertyShortlist {
  id         String              @id @default(cuid())
  userId     String
  user       Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  items      ShortlistProperty[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model ShortlistProperty {
  shortlistId String
  propertyId  String
  shortlist   PropertyShortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@id([shortlistId, propertyId])
  @@index([propertyId])
  @@index([createdAt])
}

model PropertyDocument {
  id           String               @id @default(cuid())
  propertyId   String
  uploadedById String?
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedBy   Profile?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  documentType PropertyDocumentType
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([propertyId])
  @@index([uploadedById])
  @@index([documentType])
}

model Lead {
  id          String    @id @default(cuid())
  propertyId  String?
  reelId      String?
  assignedTo  String?
  userId      String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reel        PropertyReel? @relation(fields: [reelId], references: [id], onDelete: SetNull)
  assigned    Profile?  @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: SetNull)
  user        Profile?  @relation("UserLeads", fields: [userId], references: [id], onDelete: SetNull)
  name        String
  phone       String?
  email       String?
  message     String?
  source      LeadSource @default(PROPERTY)
  contactAction ContactAction?
  stage       LeadStage @default(NEW)
  priority    String    @default("MEDIUM")
  aiScore     Int       @default(0)
  nextAction  String?
  followUpAt  DateTime?
  firstRespondedAt DateTime?
  closedAt    DateTime?
  dealValue   Decimal?
  notes       LeadNote[]
  tasks       LeadTask[]
  siteVisits  LeadSiteVisit[]
  timeline    LeadTimelineEvent[]
  notifications LeadNotification[]
  brokerAssignments BrokerLeadAssignment[]
  commissions  BrokerCommission[]
  clientDocuments BrokerClientDocument[]
  builderBookings BuilderBooking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assignedTo])
  @@index([userId])
  @@index([propertyId])
  @@index([reelId])
  @@index([source])
  @@index([contactAction])
  @@index([stage])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([authorId])
}

model BrokerTeamMember {
  id        String   @id @default(cuid())
  brokerId  String
  profileId String?
  broker    Profile  @relation("BrokerTeamOwner", fields: [brokerId], references: [id], onDelete: Cascade)
  profile   Profile? @relation("BrokerTeamProfile", fields: [profileId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  role      String   @default("AGENT")
  permissions String[] @default([])
  active    Boolean  @default(true)
  leadAssignments BrokerLeadAssignment[]
  invitedAt DateTime @default(now())
  joinedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerId])
  @@index([profileId])
  @@index([active])
}

model BrokerLeadAssignment {
  id          String   @id @default(cuid())
  leadId      String
  brokerId    String
  assigneeId  String?
  assignedById String?
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee    BrokerTeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedBy  Profile? @relation("LeadAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([brokerId])
  @@index([assigneeId])
  @@index([createdAt])
}

model BrokerCommission {
  id          String   @id @default(cuid())
  leadId      String?
  brokerId    String
  agentId     String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  broker      Profile  @relation("BrokerCommissionOwner", fields: [brokerId], references: [id], onDelete: Cascade)
  agent       Profile? @relation("BrokerCommissionAgent", fields: [agentId], references: [id], onDelete: SetNull)
  dealValue   Decimal  @default(0)
  commissionPercent Decimal @default(0)
  commissionAmount Decimal @default(0)
  status      CommissionStatus @default(PENDING)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([brokerId])
  @@index([agentId])
  @@index([status])
}

model BrokerAutomationRule {
  id        String   @id @default(cuid())
  brokerId  String
  broker    Profile  @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  channel   AutomationChannel
  trigger   AutomationTrigger
  template  String
  enabled   Boolean  @default(true)
  provider  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerId])
  @@index([channel])
  @@index([enabled])
}

model BrokerClientDocument {
  id        String   @id @default(cuid())
  leadId    String
  brokerId  String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker    Profile  @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  documentType String @default("OTHER")
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([brokerId])
  @@index([documentType])
}

model LeadTask {
  id          String    @id @default(cuid())
  leadId      String
  assignedTo  String?
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  taskType    String    @default("CALL")
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([assignedTo])
  @@index([completedAt])
}

model LeadSiteVisit {
  id          String   @id @default(cuid())
  leadId      String
  propertyId  String?
  scheduledBy String?
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  status      String   @default("SCHEDULED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([propertyId])
  @@index([scheduledAt])
  @@index([status])
}

model LeadTimelineEvent {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventType String
  message   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([actorId])
  @@index([eventType])
  @@index([createdAt])
}

model LeadNotification {
  id          String   @id @default(cuid())
  leadId      String
  recipientId String?
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipient   Profile? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  type        String
  title       String
  message     String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([recipientId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

model PropertyReel {
  id           String        @id @default(cuid())
  propertyId   String?
  ownerId      String?
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title        String
  videoUrl     String
  thumbnailUrl String?
  viewsCount   Int           @default(0)
  likesCount   Int           @default(0)
  savesCount   Int           @default(0)
  sharesCount  Int           @default(0)
  leadsCount   Int           @default(0)
  status       ListingStatus @default(PENDING_REVIEW)
  likes        ReelLike[]
  savedBy      SavedReel[]
  leads        Lead[]
  createdAt    DateTime      @default(now())

  @@index([propertyId])
  @@index([ownerId])
  @@index([status])
  @@index([viewsCount])
  @@index([likesCount])
  @@index([savesCount])
  @@index([sharesCount])
  @@index([leadsCount])
  @@index([createdAt])
}

model ReelLike {
  userId    String
  reelId    String
  user      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel      PropertyReel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, reelId])
  @@index([reelId])
  @@index([createdAt])
}

model SavedReel {
  userId    String
  reelId    String
  user      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel      PropertyReel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, reelId])
  @@index([reelId])
  @@index([createdAt])
}

model ProfileFollow {
  followerId String
  targetId   String
  follower   Profile  @relation("ProfileFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  target     Profile  @relation("ProfileFollowers", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, targetId])
  @@index([targetId])
  @@index([createdAt])
}

model StudioRequest {
  id          String    @id @default(cuid())
  requesterId String?
  propertyId  String?
  requester   Profile?  @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  payments    Payment[]
  assignments StudioAssignment[]
  files       StudioDeliveryFile[]
  revisions   StudioRevision[]
  timeline    StudioTimelineEvent[]
  notifications StudioNotification[]
  serviceType String
  city        String?
  budget      String?
  notes       String?
  status      StudioOrderStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  orderValue  Int       @default(0)
  scheduledAt DateTime?
  deliveredAt DateTime?
  approvedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  customerRating Int?
  customerFeedback String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([requesterId])
  @@index([propertyId])
  @@index([status])
  @@index([paymentStatus])
}

model StudioAssignment {
  id              String        @id @default(cuid())
  studioRequestId String
  assigneeId      String?
  studioRequest   StudioRequest @relation(fields: [studioRequestId], references: [id], onDelete: Cascade)
  assignee        Profile?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  role            String
  assignedBy      String?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([studioRequestId])
  @@index([assigneeId])
  @@index([role])
}

model StudioTimelineEvent {
  id              String        @id @default(cuid())
  studioRequestId String
  actorId         String?
  studioRequest   StudioRequest @relation(fields: [studioRequestId], references: [id], onDelete: Cascade)
  eventType       String
  message         String
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now())

  @@index([studioRequestId])
  @@index([actorId])
  @@index([eventType])
  @@index([createdAt])
}

model StudioDeliveryFile {
  id              String        @id @default(cuid())
  studioRequestId String
  studioRequest   StudioRequest @relation(fields: [studioRequestId], references: [id], onDelete: Cascade)
  fileType        String
  fileName        String
  fileUrl         String
  version         Int           @default(1)
  notes           String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@index([studioRequestId])
  @@index([fileType])
  @@index([version])
}

model StudioRevision {
  id              String        @id @default(cuid())
  studioRequestId String
  requestedById   String?
  studioRequest   StudioRequest @relation(fields: [studioRequestId], references: [id], onDelete: Cascade)
  comments        String
  version         Int           @default(1)
  status          String        @default("REQUESTED")
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  @@index([studioRequestId])
  @@index([requestedById])
  @@index([status])
}

model StudioNotification {
  id              String        @id @default(cuid())
  studioRequestId String
  recipientId     String?
  studioRequest   StudioRequest @relation(fields: [studioRequestId], references: [id], onDelete: Cascade)
  recipient       Profile?      @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  type            String
  title           String
  message         String
  readAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([studioRequestId])
  @@index([recipientId])
  @@index([type])
  @@index([readAt])
}

model ServiceRequest {
  id          String   @id @default(cuid())
  requesterId String?
  providerId  String?
  requester   Profile? @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  provider    ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  category    String
  city        String
  budget      String?
  message     String?
  status      ServiceRequestStatus @default(requested)
  quotes      ServiceQuote[]
  booking     ServiceBooking?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requesterId])
  @@index([providerId])
  @@index([category])
  @@index([status])
}

model ServiceProvider {
  id           String   @id @default(cuid())
  profileId    String?
  profile      Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  businessName String
  category     String
  city         String?
  description  String?
  portfolioUrls String[] @default([])
  photoUrls    String[] @default([])
  certifications String[] @default([])
  experienceYears Int?
  serviceAreas String[] @default([])
  availability String?
  businessHours Json @default("{}")
  rating       Decimal  @default(0)
  reviewCount  Int      @default(0)
  verified     Boolean  @default(false)
  suspended    Boolean  @default(false)
  priceLabel   String?
  requests     ServiceRequest[]
  quotes       ServiceQuote[]
  bookings     ServiceBooking[]
  reviews      ServiceReview[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([profileId])
  @@index([category])
  @@index([verified])
  @@index([suspended])
}

model ServiceQuote {
  id          String          @id @default(cuid())
  requestId   String
  providerId  String?
  request     ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider    ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  amount      Decimal?
  currency    String          @default("INR")
  message     String
  status      ServiceQuoteStatus @default(sent)
  revision    Int             @default(1)
  validUntil  DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  booking     ServiceBooking?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([requestId])
  @@index([providerId])
  @@index([status])
}

model ServiceBooking {
  id            String          @id @default(cuid())
  requestId     String          @unique
  quoteId       String?         @unique
  providerId    String
  customerId    String?
  request       ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote         ServiceQuote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  provider      ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer      Profile?        @relation("ServiceBookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  payments      Payment[]
  review        ServiceReview?
  status        ServiceBookingStatus @default(UPCOMING)
  scheduledAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  amount        Decimal?
  currency      String          @default("INR")
  depositAmount Decimal?
  commissionRate Decimal        @default(10)
  commissionAmount Decimal      @default(0)
  providerPayout Decimal        @default(0)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([providerId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
}

model ServiceReview {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  providerId  String
  reviewerId  String?
  booking     ServiceBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewer    Profile?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  rating      Int
  comment     String?
  photoUrls   String[]        @default([])
  status      ReviewStatus    @default(PUBLISHED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([providerId])
  @@index([reviewerId])
  @@index([status])
}

model BuilderProject {
  id             String   @id @default(cuid())
  builderId      String?
  builder        Profile? @relation(fields: [builderId], references: [id], onDelete: SetNull)
  name           String
  city           String
  locality       String?
  description    String?
  address        String?
  amenities      String[] @default([])
  floorPlanUrls  String[] @default([])
  masterPlanUrl  String?
  constructionStatus BuilderConstructionStatus @default(PLANNING)
  completionDate DateTime?
  unitsCount     Int?
  availableUnits Int?
  mediaUrls      String[] @default([])
  status         BuilderProjectStatus @default(DRAFT)
  campaignStatus CampaignStatus @default(DRAFT)
  featured       Boolean  @default(false)
  landingPageSlug String? @unique
  brochureUrl    String?
  qrCodeUrl      String?
  aiReport       Json     @default("{}")
  towers         BuilderTower[]
  units          BuilderUnit[]
  team           BuilderTeamMember[]
  bookings       BuilderBooking[]
  campaigns      BuilderCampaign[]
  activities     BuilderActivityLog[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([builderId])
  @@index([status])
  @@index([campaignStatus])
  @@index([city])
}

model BuilderTower {
  id        String @id @default(cuid())
  projectId String
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  floors    Int    @default(0)
  status    BuilderTowerStatus @default(ACTIVE)
  units     BuilderUnit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model BuilderUnit {
  id          String @id @default(cuid())
  projectId   String
  towerId     String?
  project     BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tower       BuilderTower? @relation(fields: [towerId], references: [id], onDelete: SetNull)
  unitNumber  String
  floor       Int?
  unitType    String
  areaValue   Decimal?
  areaUnit    String @default("sqft")
  bedrooms    Int?
  bathrooms   Int?
  facing      String?
  price       Decimal?
  status      BuilderUnitStatus @default(AVAILABLE)
  floorPlanUrl String?
  imageUrls   String[] @default([])
  bookings    BuilderBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, unitNumber])
  @@index([projectId])
  @@index([towerId])
  @@index([status])
  @@index([floor])
}

model BuilderTeamMember {
  id        String @id @default(cuid())
  builderId String
  profileId String?
  projectId String?
  builder   Profile @relation("BuilderTeamOwner", fields: [builderId], references: [id], onDelete: Cascade)
  profile   Profile? @relation("BuilderTeamProfile", fields: [profileId], references: [id], onDelete: SetNull)
  project   BuilderProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  role      String @default("SALES")
  permissions String[] @default([])
  active    Boolean @default(true)
  activities BuilderActivityLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([builderId])
  @@index([profileId])
  @@index([projectId])
  @@index([active])
}

model BuilderBooking {
  id        String @id @default(cuid())
  projectId String
  unitId    String
  leadId    String?
  buyerId   String?
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit      BuilderUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lead      Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  buyer     Profile? @relation("BuilderBookingBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  status    BuilderBookingStatus @default(RESERVED)
  bookingAmount Decimal?
  saleValue Decimal?
  notes     String?
  reservedAt DateTime @default(now())
  confirmedAt DateTime?
  releasedAt DateTime?
  soldAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([unitId])
  @@index([leadId])
  @@index([buyerId])
  @@index([status])
}

model BuilderCampaign {
  id        String @id @default(cuid())
  projectId String
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  channel   CampaignChannel
  budget    Decimal?
  leadsCount Int @default(0)
  qrCodeUrl String?
  landingPageUrl String?
  brochureDownloads Int @default(0)
  status    CampaignStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([channel])
  @@index([status])
}

model BuilderActivityLog {
  id        String @id @default(cuid())
  builderId String
  projectId String?
  teamMemberId String?
  builder   Profile @relation(fields: [builderId], references: [id], onDelete: Cascade)
  project   BuilderProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  teamMember BuilderTeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  action    String
  message   String
  metadata  Json @default("{}")
  createdAt DateTime @default(now())

  @@index([builderId])
  @@index([projectId])
  @@index([teamMemberId])
  @@index([action])
}

model AiReport {
  id         String    @id @default(cuid())
  userId     String?
  propertyId String?
  user       Profile?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reportType String
  input      Json      @default("{}")
  output     Json      @default("{}")
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([propertyId])
  @@index([reportType])
}

model AIPrompt {
  id          String      @id @default(cuid())
  promptId    String
  name        String
  description String?
  module      NotificationModule
  promptText  String      @db.Text
  version     Int         @default(1)
  active      Boolean     @default(true)
  provider    AIProvider?
  model       String?
  temperature Decimal     @default(0.4)
  maxTokens   Int?
  metadata    Json        @default("{}")
  usageLogs   AIUsageLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([promptId, version])
  @@index([promptId])
  @@index([module])
  @@index([active])
}

model AIConversation {
  id          String      @id @default(cuid())
  userId      String?
  user        Profile?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module      NotificationModule
  sessionId   String?
  title       String?
  metadata    Json        @default("{}")
  messages    AIMessage[]
  usageLogs   AIUsageLog[]
  memories    AIMemory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([module])
  @@index([sessionId])
  @@index([createdAt])
}

model AIMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   AIConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?
  user           Profile?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  role           AIMessageRole
  content        String          @db.Text
  attachments    Json            @default("[]")
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([role])
  @@index([createdAt])
}

model AIMemory {
  id             String          @id @default(cuid())
  userId         String?
  user           Profile?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scope          AIMemoryScope
  key            String
  value          Json
  expiresAt      DateTime?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([conversationId])
  @@index([scope])
  @@index([key])
  @@index([expiresAt])
}

model AIUsageLog {
  id             String          @id @default(cuid())
  userId         String?
  user           Profile?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  promptRecordId String?
  promptRecord   AIPrompt?       @relation(fields: [promptRecordId], references: [id], onDelete: SetNull)
  promptId       String?
  promptVersion  Int?
  module         NotificationModule
  provider       AIProvider
  model          String
  status         AIRequestStatus @default(SUCCESS)
  promptTokens   Int             @default(0)
  completionTokens Int           @default(0)
  totalTokens    Int             @default(0)
  estimatedCost  Decimal         @default(0)
  latencyMs      Int             @default(0)
  context        Json            @default("{}")
  result         Json            @default("{}")
  error          String?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([conversationId])
  @@index([promptId])
  @@index([module])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model AISetting {
  id          String      @id @default(cuid())
  module      NotificationModule
  provider    AIProvider  @default(OPENAI)
  model       String
  temperature Decimal     @default(0.4)
  maxTokens   Int?
  enabled     Boolean     @default(true)
  rateLimitPerMinute Int  @default(30)
  dailyCostLimit Decimal  @default(0)
  featureFlags Json       @default("{}")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([module])
  @@index([provider])
  @@index([enabled])
}

model Payment {
  id                  String          @id @default(cuid())
  payerId             String?
  payer               Profile?        @relation(fields: [payerId], references: [id], onDelete: SetNull)
  propertyId          String?
  property            Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  studioRequestId     String?
  studioRequest       StudioRequest?  @relation(fields: [studioRequestId], references: [id], onDelete: SetNull)
  serviceBookingId    String?
  serviceBooking      ServiceBooking? @relation(fields: [serviceBookingId], references: [id], onDelete: SetNull)
  subscriptionId      String?
  subscription        Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  product             PaymentProduct
  provider            PaymentProvider @default(RAZORPAY)
  status              PaymentStatus   @default(CREATED)
  amount              Int
  currency            String          @default("INR")
  description         String?
  invoiceNumber       String          @unique
  invoiceMetadata     Json            @default("{}")
  razorpayOrderId     String?         @unique
  razorpayPaymentId   String?         @unique
  razorpaySignature   String?
  razorpayWebhookEventId String?      @unique
  failureReason       String?
  paidAt              DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([payerId])
  @@index([propertyId])
  @@index([studioRequestId])
  @@index([serviceBookingId])
  @@index([subscriptionId])
  @@index([product])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id          String             @id @default(cuid())
  profileId   String?
  profile     Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  product     PaymentProduct
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime           @default(now())
  endsAt      DateTime
  payments    Payment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([profileId])
  @@index([product])
  @@index([status])
  @@index([endsAt])
}

model Notification {
  id          String                     @id @default(cuid())
  recipientId String?
  recipient   Profile?                   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  module      NotificationModule
  type        String
  priority    NotificationPriority       @default(NORMAL)
  title       String
  message     String
  actionUrl   String?
  metadata    Json                       @default("{}")
  channels    NotificationChannel[]      @default([IN_APP])
  deliveryStatus NotificationDeliveryStatus @default(PENDING)
  readAt      DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([recipientId])
  @@index([module])
  @@index([type])
  @@index([priority])
  @@index([deliveryStatus])
  @@index([readAt])
  @@index([createdAt])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String?
  reporter    Profile?         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  entityType  ReportEntityType
  entityId    String
  reason      String
  status      ReportStatus     @default(PENDING)
  adminNotes  String?
  assignedTo  String?
  resolvedAt  DateTime?
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([reporterId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  provider    WebhookProvider
  eventId     String
  eventType   String?
  payload     Json               @default("{}")
  status      WebhookEventStatus @default(RECEIVED)
  retries     Int                @default(0)
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([provider, eventId])
  @@index([provider])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String?
  phone      String
  codeHash   String
  purpose    String    @default("PHONE_VERIFICATION")
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([phone])
  @@index([phone, purpose])
  @@index([expiresAt])
}
